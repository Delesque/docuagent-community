{
  "name": "docuagent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DocuAgent desktop shell",
  "author": "Delesque",
  "license": "Apache-2.0",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "npm --prefix ../frontend run build",
    "embed": "python embed_python.py",
    "prepack": "npm run build && npm run embed",
    "pack": "npm run build && npm run embed && electron-builder --dir",
    "dist": "npm run build && npm run embed && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.delesque.docuagent",
    "productName": "DocuAgent",
    "copyright": "Copyright 2026 Delesque",
    "artifactName": "DocuAgent-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "../../.release/desktop"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/python-runtime",
        "to": "python-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "..",
        "to": "app",
        "filter": [
          "**/*.py",
          "!.*/**",
          "!tests/**",
          "!desktop/**",
          "!frontend/**",
          "!playground/**",
          "!tools/**",
          "!web-next/**",
          "!archive/**",
          "!test_*.py",
          "!**/test_*.py",
          "!**/*_test.py",
          "!**/conftest.py",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../web-next",
        "to": "app/web-next",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../../dap-app-icon.ico"
    },
    "nsis": {
      "artifactName": "DocuAgent-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "DocuAgent-Portable-${version}-${arch}.${ext}"
    }
  }
}
